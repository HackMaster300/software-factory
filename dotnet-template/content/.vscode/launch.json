{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Acme.Golden API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Acme.Golden.Api/bin/Debug/net9.0/Acme.Golden.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "NODE_ENV": "development"
      }
    }
  ]
}